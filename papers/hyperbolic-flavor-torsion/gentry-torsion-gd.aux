\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Exponential decay rates $c_k$ from log-linear fits to $\phi _{\rm  floor}^{(k)}(L)$, with 95\% bootstrap confidence intervals (2000 resamples) and $\Delta $AIC $=$ AIC(exp) $-$ AIC(pow). Negative $\Delta $AIC favours exponential over power-law. The pairings $c_1=c_4$ and $c_2=c_3$ are confirmed: their CIs overlap completely.}}{4}{table.4}\protected@file@percent }
\newlabel{tab:rates}{{4}{4}{Exponential decay rates $c_k$ from log-linear fits to $\phi _{\rm floor}^{(k)}(L)$, with 95\% bootstrap confidence intervals (2000 resamples) and $\Delta $AIC $=$ AIC(exp) $-$ AIC(pow). Negative $\Delta $AIC favours exponential over power-law. The pairings $c_1=c_4$ and $c_2=c_3$ are confirmed: their CIs overlap completely}{table.4}{}}

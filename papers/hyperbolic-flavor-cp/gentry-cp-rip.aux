\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Pareto frontier in the $(F, |J|)$ plane for the complex Borel construction on $m003$ with word triple $Ba/baB/BBa$, as the imaginary weight $\alpha $ varies from $0$ to $1.125$. The real construction ($\alpha = 0$, green dashed line) achieves $F = 0.019$ with $J = 0$. Increasing $\alpha $ continuously trades fitness for CP phase: at $\alpha = 0.9$ the fitness remains $0.020$ while $|J| = 0.013$; at $\alpha = 1.125$ the Jarlskog invariant matches the PDG value $|J_{\mathrm  {PDG}}| = 0.00966$ (red dashed line) exactly. Colour encodes $\alpha $. Values $\alpha > 1$ are geometrically permitted since the norm in~\eqref  {eq:complexaxis} is well-defined for all $\alpha \geq 0$.}}{5}{figure.1}\protected@file@percent }
\newlabel{fig:pareto}{{1}{5}{Pareto frontier in the $(F, |J|)$ plane for the complex Borel construction on $m003$ with word triple $Ba/baB/BBa$, as the imaginary weight $\alpha $ varies from $0$ to $1.125$. The real construction ($\alpha = 0$, green dashed line) achieves $F = 0.019$ with $J = 0$. Increasing $\alpha $ continuously trades fitness for CP phase: at $\alpha = 0.9$ the fitness remains $0.020$ while $|J| = 0.013$; at $\alpha = 1.125$ the Jarlskog invariant matches the PDG value $|J_{\mathrm {PDG}}| = 0.00966$ (red dashed line) exactly. Colour encodes $\alpha $. Values $\alpha > 1$ are geometrically permitted since the norm in~\eqref {eq:complexaxis} is well-defined for all $\alpha \geq 0$}{figure.1}{}}
